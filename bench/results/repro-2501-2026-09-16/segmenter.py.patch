+    def _handle_color_text(self, t: Tok, src: TokenSource, name: str) -> None:
+        r"""``\textcolor[model]{color}{text}``/``\colorbox`` 色参保护。
+
+        ``{color}`` 是语义 key 非散文——TRANSPARENT 内联会把它漏进
+        chunk content 被翻译（2501.14787 ``\textcolor{blue}`` →
+        xcolor ``Undefined color``）。href 同构：cs 与间隙字面进
+        run，``[model]?{color}`` 整段出 ``[[KEY]]``；``{text}`` 不
+        消费，主流/``in_arg`` 子扫照常内联——caption 内嵌用例同覆盖
+        （chunk-arg 的 in_arg 分支把 key 参留字面，挡不住）。
+        """
+        fid, _a, b = t.pos
+        spec = _chunk_spec_cached("om")  # [model]{color}；{text} 不拉
+        args, _end = self._args_tok(src, fid, spec, b, allow_single_token=False)
+        real = [a for a in args if a.fe > a.fs]
+        mand = next(
+            (a for a in reversed(real) if a.spec is not None and a.spec.kind == "m"),
+            None,
+        )
+        if mand is None:
+            # {color} 缺席（裸名/单 token 参）——回吐按逐字面处理
+            self._unread_args(src, args)
+            self._rappend_tok(t)
+            return
+        self._cover_gap(fid, t.pos[1])
+        vpre = self._cover_to(fid, real[0].fs if real[0].fs > b else b)
+        self._rappend(
+            self.vt.slice(vpre.start, vpre.end),
+            self.vt.slice(vpre.start, vpre.end),
+            vpre,
+        )
+        vph = self._cover_to(fid, mand.fe)  # [model]{color} 整段
+        self._rappend_ph(
+            self._ph(PhType.KEY, self.vt.slice(vph.start, vph.end)),
+            vph,
+        )
+
