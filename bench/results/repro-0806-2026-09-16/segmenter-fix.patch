+class _SurfCat(list[str]):
+    r"""surface 段容器：``\``-引导且字母结尾的元素（控制词渲染）后随字母
+    开头元素时自动插 ``" "``——TeX 控制词吞空格的 detokenize 对价。
+
+    展开组 token ``pos`` 指调用点、无 gap 字节可恢复（``_gap_surface``
+    只救 gen=0），不补则 ``{\bf X}`` 展开成 ``\bfX``——未定义控制词且
+    整词被 ``\\[a-zA-Z]+`` 当单 cs 保留、逃逸翻译（0806.3472 的
+    ``\bfKostant``）。ph 串 ``[[X_n]]`` 非字母开头恒不触发。
+    """
+
+    def append(self, s: str) -> None:
+        """元素入列——边界处控制词/字母融合判定见 docstring。"""
+        if (
+            self
+            and s[:1].isalpha()
+            and self[-1].startswith("\\")
+            and self[-1][-1:].isalpha()
+        ):
+            super().append(" ")
+        super().append(s)
+
+
