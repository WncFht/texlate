{
  "name": "zotero-texlate",
  "type": "module",
  "version": "0.1.1",
  "description": "Zotero plugin for TeXlate — translate arXiv papers to Chinese via a texlate server",
  "config": {
    "addonName": "TeXlate",
    "addonID": "texlate@hjfy.top",
    "addonRef": "texlate",
    "addonInstance": "texlate",
    "prefsPrefix": "extensions.zotero.texlate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WncFht/texlate.git"
  },
  "author": "TeXlate contributors",
  "homepage": "https://github.com/WncFht/texlate",
  "license": "Apache-2.0",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "~5.1.4"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "globals": "^14.0.0",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
