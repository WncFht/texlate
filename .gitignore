# python
__pycache__/
*.pyc
.coverage*
.venv/
.venv_*/
# uv build 产物（release.yml 也产出于此——永远不跟踪）
/dist/

# node
node_modules/

# SPA 产物拷入位 (scripts/build-web.sh 生成,wheel 经 hatch artifacts 携带)
/src/texlate/server/static/

# bench 重产物 (可重建,不入库)
bench/corpus/*/
bench/corpus_v2/*/
bench/corpus_v2/progress.json
bench/corpus_v2/build.log
bench/corpus_v3/*/
bench/work_*/
bench/results/*/work/
bench/results/babeldoc/
!bench/corpus/MANIFEST.md
!bench/corpus_v2/MANIFEST.md

# status-panel 运行时状态 (pidfile+速率状态; run.log 由 *.log 覆盖, tasks.d 台账照入库)
bench/results/status-panel/panel.pid
bench/results/status-panel/rate-state.json

# tex 编译中间产物
*.aux
*.log
*.out
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
# tests/fixtures/ 的 .log 是入库测试输入,非编译产物
!tests/fixtures/*.log
!tests/fixtures/logs/*.log

# 本机 agent 层 (软链,由 scripts/agent-links.sh / crossnote-links.sh 重建)
/CLAUDE.md
/.claude/
/.crossnote/

# 工具缓存
.ruff_cache/

# 调研实验现场 (repos/reports/experiments)
tmp/

# 文献原件 (PDF/HTML 二进制,可再生)
docs/research/lit/
.DS_Store
