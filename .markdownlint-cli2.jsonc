{
    // 生成物与依赖不进 lint 扫描；规则本身在 .markdownlint.jsonc
    // corpus 子目录等 gitignored 重产物只存在于本机
    // globs：裸跑 markdownlint-cli2（无参）时的默认文件集——无参扫 0 文件，
    // npm lint:md 显式传 "**/*.md" 与此同口径
    "globs": ["**/*.md"],
    // ignores 与 .gitignore 对齐：本地 lint 视图 = CI 干净检出视图
    "ignores": [
        "**/node_modules/**",
        "**/tmp/**",
        "paper-search-*/**",
        "dist/**",
        ".claude/**",
        ".crossnote/**",
        "CLAUDE.md",
        "src/texlate/server/static/**",
        "bench/corpus/*/**",
        "bench/corpus_iclr_pdf/**",
        "bench/zh-store/*/**",
        "bench/archive-*/*/**",
        "bench/results/**",
        "bench/work_*/**",
        "bench/frame/**",
        "docs/HANDOFF-*.md",
        // .agents/skills/ 是 vendored skill 原样入库区——上游 md 有自己的
        // 排版约定，不吃本仓 lint 口径（与 eslint/ruff/shellcheck 同政策）
        ".agents/**",
        "**/.venv*/**",
    ],
}
