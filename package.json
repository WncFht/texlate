{
    "private": true,
    "scripts": {
        "format": "prettier --write \"**/*.{yaml,yml}\" \"**/*.{js,mjs,cjs,ts,tsx,json,css,html}\"",
        "format:check": "prettier --check \"**/*.{yaml,yml}\" \"**/*.{js,mjs,cjs,ts,tsx,json,css,html}\"",
        "lint:md": "markdownlint-cli2 \"**/*.md\"",
        "lint:py": "ruff format --check . && ruff check .",
        "lint:js": "eslint . --max-warnings 0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "git-format-staged": "4.0.2",
        "globals": "^17.12.0",
        "markdownlint-cli2": "0.23.3",
        "prettier": "3.9.9"
    },
    "overrides": {
        "smol-toml": "1.8.0"
    }
}
