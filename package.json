{
    "private": true,
    "scripts": {
        "format": "prettier --write \"**/*.md\" \"**/*.{yaml,yml}\" \"**/*.{js,mjs,cjs,json}\"",
        "format:check": "prettier --check \"**/*.md\" \"**/*.{yaml,yml}\" \"**/*.{js,mjs,cjs,json}\"",
        "lint:md": "markdownlint-cli2 \"**/*.md\"",
        "lint:py": "ruff format --check . && ruff check .",
        "lint:js": "eslint ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.10.0",
        "git-format-staged": "4.0.2",
        "globals": "^17.12.0",
        "markdownlint-cli2": "0.23.2",
        "prettier": "3.9.6"
    },
    "overrides": {
        "smol-toml": "1.8.0"
    }
}
