% texlate vendored stub — 原许可禁分发，最小兼容面
% diagrams.sty S1+ 替身：Paul Taylor 交换图 DSL，"no redistribution"
% 许可（TL 除名件）→ 不可 vendored。设计取渲染降级路线而非吞体：
% \diagram…\enddiagram 与 \begin{diagram}…\end{diagram} 两式共用
% 一对 cs 映射进 displaymath，箭头 cs 直映真数学符号——节点/标签
% 照常排版，仅网格定位丢失（线性串排），无吞体/组泄风险。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{diagrams}[texlate stub — original not redistributable]
\PackageWarningNoLine{texlate-stub}{diagrams.sty is a compatibility shim}

% —— 包选项静默吞：PostScript=dvips/noPS 等渲染开关对不画网格的
%    stub 无义, 不声明会出 Unknown option 错 (1206.1835 实证) ——
\DeclareOption*{}
\ProcessOptions\relax

% —— 两种调用式：\begin{diagram} 走 env 机制调 \diagram/\enddiagram；
%    plain 式 \diagram…\enddiagram 同名直达。网格分隔符降级:
%    &/\cr 在 displaymath 里非法 → 组内局部降为空白 (同格实证:
%    misplaced & ×88 + \cr ×22 占残余大头)。& 须先 active 化
%    才可 \def —— 外层组预激活让体内 token 以 active 形入宏。
\begingroup
\catcode`\&=\active
\gdef\diagram{\begingroup
  \let\\=\space \let\cr\space
  \catcode`\&=\active \def&{\ }%
  \ifmmode \let\diagrams@disp=\relax \else \let\diagrams@disp=\] \[\fi}
\endgroup
% {diagram} 可嵌进 {equation} 等数学环境 (同格实证) —— 已处数学域
% 不开 \[, \diagrams@disp 记 \relax; 否则记 \] 供 \enddiagram 对称
% 关域 (不能现测 \ifmmode: 开过的 \[ 里恒真会漏关)。
\def\enddiagram{\diagrams@disp\endgroup}

