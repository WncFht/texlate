% \markcite/\reference 真身均单参 {key} (9910310 \markcite{Na_95}/
% \reference{Al_96} 实证): 0-arg 版把 {key} 漏进正文流, _ 触发
% Missing $ 级联 —— 收 key noop。
\def\markcite#1{}
\def\reference#1{\refpar}
% ── epsf 系图片件 ──
\def\eps@scaling{.95}
\def\epsscale#1{\def\eps@scaling{#1}}
\def\plotone#1{\par\medskip\centering\leavevmode
\epsfxsize=\eps@scaling\columnwidth\epsfbox{#1}\par\medskip}
\def\plottwo#1#2{\par\medskip\centering\leavevmode
\epsfxsize=.45\columnwidth\epsfbox{#1}\hfil
\epsfxsize=.45\columnwidth\epsfbox{#2}\par\medskip}
% \plotfiddle{file}{voff}{rot}{hsf}{vsf}{htrans}{vtrans} (aastex
% 7参变换形, 9901236 实证 28 调) → 降级吃 file+忽略变换
\def\plotfiddle#1#2#3#4#5#6#7{\par\medskip\centering\leavevmode
\epsfxsize=\eps@scaling\columnwidth\epsfbox{#1}\par\medskip}
