% ── deluxetable 复合面 (aaspp4 实证模型): \@delspec 延迟开张 ──
\newenvironment{deluxetable}[1]{\begin{table}[htbp]\centering\def\@delspec{#1}}{\end{table}}
\newenvironment{deluxetable*}[1]{\begin{table}[htbp]\centering\def\@delspec{#1}}{\end{table}}
\let\planotable=\deluxetable
\let\endplanotable=\enddeluxetable
\def\tablewidth#1{}
\def\tablecolumns#1{}
\def\tablecaption#1{\caption{#1}}
\def\tablehead#1{\expandafter\tabular\expandafter{\@delspec}#1\\\hline}
\def\tabletail#1{}
\def\tableheadfrac#1{}
\def\startdata{}
\def\enddata{\endtabular}
\def\nl{\\}
\let\nextline=\nl
\def\tableline{\hline}
\def\colhead#1{#1}
\def\tablevspace#1{\noalign{\vskip#1}}
\def\tablebreak{\\}
\def\cutinhead#1{\hline#1\\\hline}
