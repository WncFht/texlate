% texlate vendored stub — 原许可禁分发，最小兼容面
% slashbox.sty S1 替身：无许可声明（TL 除名件）→ 不可 vendored。
% \slashbox/\backslashbox 退化为单元格内上下堆叠文本（tabular 安全）。
% \makebox 受限横态下参内 \\ 变 tabular 行尾炸 Missing/Extra }
% （1109.5364 \backslashbox{\\climate\\ variable}{zone} 实证）——
% \shortstack 把 \\ 当栈内换行消化，渲染降级但不再硬死。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{slashbox}[texlate stub — original not redistributable]
\PackageWarningNoLine{texlate-stub}{slashbox.sty is a compatibility shim}

\providecommand{\slashbox}[3][60mm]{\shortstack[l]{#2\\#3}}
\providecommand{\backslashbox}[3][60mm]{\shortstack[l]{#3\\#2}}
\endinput
