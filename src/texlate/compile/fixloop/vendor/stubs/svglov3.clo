% texlate vendored stub — 原许可禁分发，最小兼容面
% svglov3.clo 伴生件：svjour3.cls 真件在 journalopt 空时 \input 的
% "global" 期刊式样文件。真件内含 \validfor/\if@runhead + size10.clo
% 字体段复刻 + 版心尺寸——stub 镜像最小必需面：
%   \def\validfor{svjour3}      — cls option-clash 校验点
%   \global\let\if@runhead\iftrue — running-heads 模式位
%   \input{size10.clo}          — 内核 10pt 字体/列表段 (真件内联同款)
% catcode 纪律 (1608.06693 实证)：旧 stub 尾置 \makeatother, class-load
% 语境 \input 返回后 @ 失字母位 → svjour3.cls:159 `15\p@` 断读级联。
% 此处不用 \makeatletter/\makeatother 而用 \catcode 64 存复: @=letter
% (class-load) 与 @=other (doc \input) 两语境皆精确回原位, 且无 @-cs
% 名面 (\svglovrestore 纯字母)。
\ProvidesFile{svglov3.clo}[2026/09/19 texlate stub — svglov3 size/layout shim]
\edef\svglovrestore{\catcode 64=\the\catcode 64\relax}
\catcode 64=11\relax
\def\validfor{svjour3}
\global\let\if@runhead\iftrue
\input{size10.clo}
% svjour3 frontmatter 脚注件 (2511.15773 实证: 真 .clo 供 \thanksref/
% \thankstext —— 稿未随件则 \author 内 \thanksref{e1,addr1} 炸
% Undefined cs)。\thanksref 吃逗号分隔 key 列, \@for 逐项 \ref
% 上标; \thankstext{key}{text} 走 AtBeginDocument 双语境安全钩
% (in-doc 立行/preamble 存值同款) —— \refstepcounter 起专数器写
% \label 使 \ref 可解, \footnotetext 落页脚。稿自供恒赢
% (\providecommand 先行)。定义须在 \svglovrestore 前 (@=letter 窗内)。
\@ifundefined{c@svthanks}{\newcounter{svthanks}\setcounter{svthanks}{0}}{}
\providecommand{\thanksref}[1]{\textsuperscript{%
\def\svt@sep{}\@for\svt@k:=#1\do{\svt@sep\ref{\svt@k}\def\svt@sep{,}}}}
\providecommand{\thankstext}[2]{\AtBeginDocument{%
\refstepcounter{svthanks}\label{#1}\footnotetext{#2}}}
\svglovrestore
\PackageWarningNoLine{texlate-stub}{svglov3.clo is a size/layout shim}
\endinput
