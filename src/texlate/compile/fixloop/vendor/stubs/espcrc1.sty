% texlate vendored stub — 原许可禁分发，最小兼容面
% espcrc1.sty S1 替身：Elsevier "NOT ALLOWED to distribute this file
% alone" → 不可 vendored。Elsevier 一栏 CRC 版式件：边距设定全跳，
% 只补 \usepackage{espcrc1} 加载门槛 + 偶见的 ESP frontmatter cs。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{espcrc1}[texlate stub — original not redistributable]
\PackageWarningNoLine{texlate-stub}{espcrc1.sty is a compatibility shim}

\DeclareOption*{ }
\ProcessOptions\relax

% ESP CRC frontmatter/版式 cs no-op 面
\providecommand{\titlepage}{}
\providecommand{\thankyou}[1]{}
\providecommand{\frontmatter}{}
\providecommand{\mainmatter}{}
\providecommand{\bookhead}[1]{}
\providecommand{\confhead}[1]{}
\providecommand{\hypothesis}[1]{\begin{quote}\itshape #1\end{quote}}
\providecommand{\acknowledgments}[1]{\par\noindent\textbf{Acknowledgments:} #1\par}
% —— \addressmark[key]+\address[key]{…} 作者脚注族（nucl-th/0104004 实证：
%    稿把 \addressmark[label]\address{…} 编进 \author 参 → article
%    \maketitle 的 tabular cell 内展开；\\ 须降为 \newline 防顶破
%    halign。内联输出形任何版式面安全） ——
\providecommand{\addressmark}[1][]{\textsuperscript{#1}}
\providecommand{\address}[2][]{{\let\\\newline\textsuperscript{#1}{\footnotesize #2}}}
% —— \readRCS$Id: f,v ver date …$：RCS 美元定界串五参解析（真件抄值——
%    $#1: #2 #3 #4 #5$ 定界形，非普参；产 \filename/\fileversion/\filedate
%    喂后随 \ProvidesFile/\ProvidesPackage[…] 的 \xdef，纯吞参会让两 cs
%    残成新 undef。hep-ph/0408075 实证全 decline→salvage err=106） ——
\def\readRCS$#1: #2 #3 #4 #5${%
  \def\filename{#2}%
  \def\fileversion{#3}%
  \def\filedate{#4}%
}
\endinput
