% texlate vendored stub — 原许可禁分发，最小兼容面
% espcrc2.sty S1 替身：同 espcrc1 Elsevier 许可禁独立分发；fetch
% 亦无档 → stub。两栏版式诉求由 twocolumn class 原生能力担，
% 本件只过 \usepackage{espcrc2} 加载门槛 + frontmatter no-op 面。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{espcrc2}[texlate stub — original not redistributable]
\PackageWarningNoLine{texlate-stub}{espcrc2.sty is a compatibility shim}

\DeclareOption*{ }
