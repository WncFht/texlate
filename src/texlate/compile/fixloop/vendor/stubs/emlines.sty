\IfFileExists{epic.sty}{\RequirePackage{epic}}{%
  \PackageWarningNoLine{texlate-stub}{emlines: epic absent, \string\emline\space degraded to no-op}}
% \emline{x1}{y1}{tag1}{x2}{y2}{tag2}: tag 参为 TeXCAD 节点号，
% 纯注释义 → 吞。坐标记法 decimal-unitlength 与 \drawline 同形。
% \@ifundefined{drawline} 调时闸: epic 在场直行, 缺席 noop。
\providecommand{\emline}[6]{\@ifundefined{drawline}{}{\drawline(#1,#2)(#4,#5)}}
