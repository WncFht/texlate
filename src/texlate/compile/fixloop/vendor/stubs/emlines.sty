\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{emlines}[2026/09/28 texlate stub — original not redistributable]
\PackageWarningNoLine{texlate-stub}{emlines.sty is a compatibility shim -> epic drawline}
\DeclareOption*{}
