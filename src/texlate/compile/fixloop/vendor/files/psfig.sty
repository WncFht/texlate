%% texlate-fixloop vendored bridge: psfig.sty -> epsfig
%% The real psfig v1.10 emits dvips-era \special{psfile=...} which the
%% xelatex/xdvipdfmx pipeline cannot render; epsfig.sty is the official
%% (e)psfig emulation (defines \psfig + \epsfig + Gin figure/file keys).
\ProvidesPackage{psfig}[2026/09/20 fixloop epsfig bridge]
\DeclareOption*{\PassOptionsToPackage{\CurrentOption}{graphicx}}
\ProcessOptions\relax
\RequirePackage{epsfig}
%% psfig-era reserved-dim keys rheight/rwidth -> Gin height/width aliases
%% (same body as 90-shim-legacy psfig.tex shim; catcode64 save/restore wrap
%% because \input-style loads can arrive with @=12).
\edef\psfigrestore{\catcode 64=\the\catcode 64\relax}
\catcode 64=11\relax
\define@key{Gin}{rheight}{\def\Gin@eheight{#1}}
\define@key{Gin}{rwidth}{\def\Gin@ewidth{#1}}
\psfigrestore
\endinput
